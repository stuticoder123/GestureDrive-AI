<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml — Maven Project Object Model
  =====================================
  Maven is Java's build tool + dependency manager (like pip for Python).
  This file tells Maven:
    - What your project is named
    - What libraries it needs (JavaFX)
    - How to compile and run it

  HOW TO USE:
    In IntelliJ: File → Open → select this pom.xml → Open as Project
    Maven will download all dependencies automatically (requires internet).

  HOW TO RUN:
    In IntelliJ terminal:  mvn javafx:run
    Or use IntelliJ's green Run button after setting up run configuration.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ── PROJECT IDENTITY ─────────────────────────────────────────────── -->
    <groupId>com.gesturecargame</groupId>      <!-- your "company" namespace -->
    <artifactId>gesture-car-game</artifactId>  <!-- project name -->
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Gesture Car Game</name>
    <description>AI-powered hand gesture controlled car game using JavaFX and Python</description>

    <!-- ── JAVA VERSION ─────────────────────────────────────────────────── -->
    <properties>
        <maven.compiler.source>21</maven.compiler.source>   <!-- use Java 21 -->
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.2</javafx.version>
    </properties>

    <!-- ── DEPENDENCIES (libraries your project needs) ─────────────────── -->
    <dependencies>

        <!-- JavaFX Controls — Button, Label, etc (needed for UI) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JavaFX Graphics — Canvas, Shape, Color, AnimationTimer -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JavaFX FXML — if you want XML-based UI layouts later -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

    </dependencies>

    <!-- ── BUILD PLUGINS ────────────────────────────────────────────────── -->
    <build>
        <plugins>

            <!-- JavaFX Maven Plugin — lets you run with: mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <!-- This must match your main class exactly -->
                    <mainClass>com.gesturecargame.Main</mainClass>
                </configuration>
            </plugin>

            <!-- Maven Compiler Plugin — ensures Java 21 is used -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>